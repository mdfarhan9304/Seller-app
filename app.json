{
  "expo": {
    "name": "Unicapp Seller",
    "slug": "unicapp-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpg",
    "scheme": "unicapp-seller",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAHoCHhp2PXw0MpwCgEU7ojjKb0diF_LCM"
      },
      "bundleIdentifier": "com.unicapp.store"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.unicapp.store",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAHoCHhp2PXw0MpwCgEU7ojjKb0diF_LCM"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
